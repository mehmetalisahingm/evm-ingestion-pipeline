# EVM Network
CHAIN_NAME=bsc
CHAIN_ID=56

# RPC Providers
HTTP_RPC_URL=
WS_RPC_URL=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=evm.raw

# Redis
REDIS_URL=redis://localhost:6379/0

# Ingestion throughput / queue limits
BLOCK_QUEUE_MAX_SIZE=20
LOG_QUEUE_MAX_SIZE=5000
BACKFILL_CONCURRENCY=5
INGESTION_TARGET_EVENTS_PER_SECOND=900

# Monitoring
MONITORING_PORT=8000

KAFKA_RAW_TOPIC=evm.raw
KAFKA_NORMALIZED_TOPIC=evm.normalized
KAFKA_DLQ_TOPIC=evm.dlq

NORMALIZER_CONSUMER_GROUP=normalizer-service
NORMALIZER_SCHEMA_VERSION=1
NORMALIZER_MONITORING_PORT=8001

KAFKA_CANONICAL_TOPIC=canonical-events
REORG_CONSUMER_GROUP=reorg-service
REORG_WINDOW_SIZE=50
REORG_PENDING_TTL_SECONDS=120
REORG_SCHEMA_VERSION=1
REORG_MONITORING_PORT=8002
